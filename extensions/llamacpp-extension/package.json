{
  "name": "@ax-studio/llamacpp-extension",
  "productName": "llama.cpp Inference Engine",
  "version": "1.0.4",
  "description": "This extension enables llama.cpp local inference for Ax-Studio",
  "main": "dist/index.js",
  "engine": "llamacpp",
  "author": "Ax-Studio <service@axstudio.ai>",
  "license": "Apache-2.0",
  "homepage": "https://github.com/defai-digital/ax-studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/defai-digital/ax-studio.git",
    "directory": "extensions/llamacpp-extension"
  },
  "scripts": {
    "build": "rolldown -c rolldown.config.mjs",
    "build:publish": "rimraf *.tgz --glob || true && yarn build && npm pack",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "devDependencies": {
    "react": "19.0.1",
    "rimraf": "6.0.1",
    "rolldown": "1.0.0-beta.1",
    "typescript": "5.9.2",
    "vitest": "3.2.6"
  },
  "dependencies": {
    "@ax-studio/core": "../../core/package.tgz",
    "@ax-studio/tauri-plugin-llamacpp-api": "link:../llamacpp-api"
  },
  "peerDependencies": {
    "react": "19.0.1"
  },
  "files": [
    "dist/*",
    "package.json",
    "LICENSE",
    "NOTICE"
  ],
  "bundleDependencies": [],
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "packageManager": "yarn@4.5.3"
}
