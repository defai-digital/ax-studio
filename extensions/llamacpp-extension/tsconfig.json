{
  "compilerOptions": {
    "target": "es2020",
    "module": "ES6",
    "moduleResolution": "node",
    "lib": [
      "es2020",
      "dom"
    ],
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true,
    "rootDir": "./src",
    "paths": {
      "@tauri-apps/api/core": [
        "../../web-app/src/lib/tauri-shim/api-core.ts"
      ],
      "@tauri-apps/api/event": [
        "../../web-app/src/lib/tauri-shim/api-event.ts"
      ],
      "@tauri-apps/plugin-http": [
        "../../web-app/src/lib/tauri-shim/plugin-http.ts"
      ]
    }
  },
  "include": [
    "./src"
  ],
  "exclude": [
    "**/*.test.ts"
  ]
}
