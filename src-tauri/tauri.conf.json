{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AX Studio",
  "version": "2.2.1",
  "identifier": "ai.axstudio.app",
  "build": {
    "frontendDist": "../web-app/dist",
    "devUrl": "http://localhost:31420",
    "beforeDevCommand": "node scripts/tauri-dev-web.mjs",
    "beforeBuildCommand": "node scripts/prepare-ios-xcode.mjs && node scripts/run-with-env.mjs IS_TAURI=true yarn build:web"
  },
  "app": {
    "macOSPrivateApi": false,
    "windows": [
      {
        "label": "main",
        "title": "AX Studio",
        "width": 1200,
        "minWidth": 1024,
        "height": 800,
        "minHeight": 740,
        "resizable": true,
        "fullscreen": false,
        "zoomHotkeysEnabled": true,
        "center": true,
        "hiddenTitle": true,
        "transparent": false,
        "trafficLightPosition": {
          "x": 20,
          "y": 32
        },
        "decorations": true,
        "titleBarStyle": "Overlay",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "capabilities": [
        "default",
        "log-app-window",
        "logs-window",
        "system-monitor-window"
      ],
      "csp": {
        "default-src": "'self'",
        "connect-src": "'self' asset: ipc: data: http://asset.localhost http://ipc.localhost http://127.0.0.1:* http://localhost:* ws://localhost:* ws://127.0.0.1:* https://huggingface.co https://hf.co https://cdn-lfs*.huggingface.co https://*.axstudio.ai https://updates.axstudio.ai https://api.github.com https://api.z.ai https://objects.githubusercontent.com https://github-releases.githubusercontent.com",
        "font-src": [
          "'self' asset: http://asset.localhost https://fonts.gstatic.com blob: data: tauri://localhost http://tauri.localhost"
        ],
        "img-src": "'self' asset: http://asset.localhost blob: data: https:",
        "style-src": "'unsafe-inline' 'self' https://fonts.googleapis.com",
        "script-src": "'self' asset: http://asset.localhost",
        "frame-src": "'self'"
      },
      "assetProtocol": {
        "enable": true,
        "scope": {
          "requireLiteralLeadingDot": true,
          "allow": []
        }
      }
    }
  },
  "plugins": {
    "os": {
      "version": "latest",
      "resolve": true
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY5MzcxMUFCQjdFQjAyRTQKUldUa0F1dTNxeEUzYWI4ZUIySW1zMkUvYnBoTHZ1RnZxZFJpWW95ME1HUGNwb1VycGdISnV1UUkK",
      "endpoints": [
        "https://github.com/defai-digital/ax-studio/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  },
  "bundle": {
    "publisher": "DEFAI Private Limited",
    "active": true,
    "createUpdaterArtifacts": false,
    "iOS": {
      "developmentTeam": "N5ZUZDUJS6"
    },
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/LICENSE"
    ],
    "fileAssociations": [
      {
        "ext": [
          "png",
          "jpg",
          "jpeg"
        ],
        "name": "Image",
        "role": "Viewer"
      },
      {
        "ext": [
          "pdf"
        ],
        "name": "PDF Document",
        "role": "Viewer",
        "mimeType": "application/pdf"
      },
      {
        "ext": [
          "txt",
          "md",
          "csv"
        ],
        "name": "Text Document",
        "role": "Viewer"
      },
      {
        "ext": [
          "docx",
          "pptx",
          "xlsx",
          "xls",
          "ods",
          "html",
          "htm"
        ],
        "name": "Document",
        "role": "Viewer"
      }
    ]
  }
}
