{
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AX Studio",
        "width": 1200,
        "minWidth": 1024,
        "height": 800,
        "minHeight": 740,
        "resizable": true,
        "fullscreen": false,
        "zoomHotkeysEnabled": true,
        "center": true,
        "hiddenTitle": true,
        "transparent": false,
        "trafficLightPosition": {
          "x": 20,
          "y": 32
        },
        "decorations": true,
        "titleBarStyle": "Overlay",
        "windowEffects": {
          "effects": ["fullScreenUI", "sidebar"],
          "state": "active"
        },
        "acceptFirstMouse": true,
        "focus": true,
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "targets": ["app", "dmg"],
    "resources": ["resources/pre-install/**/*", "resources/LICENSE"],
    "externalBin": ["resources/bin/bun", "resources/bin/uv"],
    "macOS": {
      "entitlements": "./Entitlements.plist",
      "minimumSystemVersion": "15.0",
      "frameworks": [
        "resources/lib/libmlx.dylib",
        "resources/lib/libjaccl.dylib"
      ],
      "files": {
        "Resources/mlx.metallib": "resources/lib/mlx.metallib"
      }
    }
  }
}
