{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "enables the default permissions for desktop platforms",
  "windows": ["main"],
  "remote": {
    "urls": []
  },
  "platforms": ["macOS", "windows"],
  "permissions": [
    "core:default",
    "core:webview:allow-set-webview-zoom",
    "core:window:allow-start-dragging",
    "core:window:allow-set-theme",
    "core:window:allow-get-all-windows",
    "core:event:allow-listen",
    "core:app:allow-set-app-theme",
    "core:window:allow-set-focus",
    "os:default",
    "log:default",
    "core:webview:allow-create-webview-window",
    "opener:allow-reveal-item-in-dir",
    "store:default",
    "deep-link:default",
    "hardware:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://huggingface.co/**"
        },
        {
          "url": "https://hf.co/**"
        },
        {
          "url": "https://cdn-lfs*.huggingface.co/**"
        },
        {
          "url": "https://api.github.com/**"
        },
        {
          "url": "https://api.z.ai/**"
        },
        {
          "url": "https://github.com/**"
        },
        {
          "url": "https://objects.githubusercontent.com/**"
        },
        {
          "url": "https://github-releases.githubusercontent.com/**"
        },
        {
          "url": "http://127.0.0.1:*"
        },
        {
          "url": "http://localhost:*"
        }
      ],
      "deny": []
    },
    {
      "identifier": "opener:allow-open-url",
      "description": "opens the default permissions for the core module",
      "windows": ["*"],
      "allow": [
        {
          "url": "https://*"
        },
        {
          "url": "http://127.0.0.1:*"
        }
      ]
    }
  ]
}
