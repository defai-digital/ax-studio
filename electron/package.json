{
  "name": "@ax-studio/electron",
  "private": true,
  "version": "0.0.0",
  "description": "AX Studio Electron shell",
  "author": "DEFAI Private Limited",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/main.js",
  "exports": {
    ".": "./dist/embed.js",
    "./embed": "./dist/embed.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "dist-preload/",
    "dist-renderer/"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.preload.json && node scripts/write-preload-manifest.mjs && node scripts/copy-renderer.mjs",
    "start": "electron .",
    "smoke": "electron . --smoke",
    "smoke:embed": "yarn workspace @ax-studio/electron-example-host smoke"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "unzipper": "^0.12.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "22.14.1",
    "electron": "^43.2.0",
    "electron-builder": "^26.0.12",
    "typescript": "5.9.2"
  }
}
