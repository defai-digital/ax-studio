{
  "name": "ax-studio-app",
  "private": true,
  "license": "Apache-2.0",
  "homepage": "https://github.com/defai-digital/ax-studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/defai-digital/ax-studio.git"
  },
  "type": "module",
  "workspaces": {
    "packages": [
      "core",
      "web-app"
    ]
  },
  "scripts": {
    "lint": "yarn workspace @ax-studio/core lint && yarn workspace @ax-studio/web-app lint",
    "dev": "yarn dev:tauri",
    "build": "yarn build:web && yarn build:tauri",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:module:audit": "node scripts/testing/module-coverage-audit.mjs --out-dir report/testing",
    "test:module:gate": "node scripts/testing/module-coverage-gate.mjs --audit report/testing/module-coverage-audit.json --thresholds scripts/testing/module-thresholds.json --mode advisory",
    "test:module:gate:blocking": "node scripts/testing/module-coverage-gate.mjs --audit report/testing/module-coverage-audit.json --thresholds scripts/testing/module-thresholds.json --mode blocking",
    "test:quality:gates": "bash scripts/testing/run-quality-gates.sh",
    "test:quality:gates:blocking": "COVERAGE_GATE_MODE=blocking bash scripts/testing/run-quality-gates.sh",
    "test:prepare": "yarn build:icon && yarn copy:assets:tauri && yarn build --no-bundle ",
    "dev:web": "yarn workspace @ax-studio/web-app dev",
    "dev:tauri": "yarn build:icon && yarn copy:assets:tauri && tauri dev",
    "copy:assets:tauri": "node scripts/copy-assets-tauri.mjs",
    "download:lib": "node ./scripts/download-lib.mjs",
    "download:bin": "node ./scripts/download-bin.mjs",
    "build:tauri:win32": "yarn build:icon && yarn copy:assets:tauri && yarn download:bin && yarn tauri build",
    "build:tauri:darwin": "yarn download:bin && yarn tauri build --target universal-apple-darwin",
    "build:tauri": "yarn build:icon && yarn copy:assets:tauri && yarn download:bin && node scripts/tauri-build.mjs",
    "build:tauri:plugin:api": "cd src-tauri/plugins && yarn install && yarn workspaces foreach -Apt run build",
    "build:icon": "tauri icon ./src-tauri/icons/icon.png",
    "build:core": "cd core && yarn build && yarn pack",
    "build:web": "yarn workspace @ax-studio/web-app build",
    "build:extensions": "mkdir -p ./pre-install && rimraf ./pre-install/*.tgz || true && yarn build:core && cd extensions && yarn install && yarn workspaces foreach -Apt run build:publish",
    "prepare": "husky"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.7.0",
    "@vitest/coverage-v8": "3.2.6",
    "husky": "^9.1.5",
    "jsdom": "^29.1.1",
    "rimraf": "^6.0.1",
    "tar": "^7.5.16",
    "unzipper": "^0.12.3",
    "vitest": "^3.2.6"
  },
  "version": "1.5.0",
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "resolutions": {
    "yallist": "4.0.0",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "brace-expansion@npm:^2.0.1": "2.0.3",
    "@eslint/plugin-kit@npm:^0.2.8": "0.3.4",
    "@smithy/config-resolver@npm:^3.0.4": "4.4.6",
    "@smithy/config-resolver@npm:^3.0.13": "4.4.6",
    "@smithy/config-resolver@npm:^4.2.1": "4.4.6",
    "bn.js@npm:^5.2.1": "5.2.3",
    "esbuild@npm:^0.27.0": "0.28.1",
    "fast-xml-parser@npm:4.2.5": "4.5.5",
    "fast-xml-parser@npm:5.2.5": "5.9.3",
    "form-data@npm:4.0.0": "4.0.6",
    "form-data@npm:^4.0.4": "4.0.6",
    "glob@npm:^10.2.2": "13.0.6",
    "glob@npm:^11.0.0": "13.0.6",
    "minimatch@npm:^10.0.3": "10.2.3",
    "minimatch@npm:^9.0.4": "9.0.7",
    "picomatch@npm:^4.0.2": "4.0.4",
    "picomatch@npm:^4.0.3": "4.0.4",
    "qs@npm:6.11.2": "6.15.2",
    "qs@npm:^6.12.3": "6.15.2",
    "tar@npm:^7.4.3": "7.5.16",
    "test-exclude@npm:^7.0.1": "8.0.0",
    "uuid@npm:^9.0.1": "11.1.1",
    "vite@npm:^5.0.0 || ^6.0.0 || ^7.0.0-0": "7.3.5",
    "ws@npm:^8.18.0": "8.21.0"
  },
  "packageManager": "yarn@4.5.3"
}
