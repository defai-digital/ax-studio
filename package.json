{
  "name": "ax-studio-app",
  "private": true,
  "license": "Apache-2.0",
  "homepage": "https://github.com/defai-digital/ax-studio",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/defai-digital/ax-studio.git"
  },
  "engines": {
    "node": "^24.0.0"
  },
  "type": "module",
  "workspaces": {
    "packages": [
      "core",
      "web-app",
      "electron",
      "examples/electron-host"
    ]
  },
  "scripts": {
    "lint": "yarn workspace @ax-studio/core lint && yarn workspace @ax-studio/web-app lint",
    "dev": "yarn dev:electron",
    "build": "yarn build:electron",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:module:audit": "node scripts/testing/module-coverage-audit.mjs --out-dir report/testing",
    "test:module:gate": "node scripts/testing/module-coverage-gate.mjs --audit report/testing/module-coverage-audit.json --thresholds scripts/testing/module-thresholds.json --mode blocking",
    "test:module:gate:blocking": "node scripts/testing/module-coverage-gate.mjs --audit report/testing/module-coverage-audit.json --thresholds scripts/testing/module-thresholds.json --mode blocking",
    "test:quality:gates": "bash scripts/testing/run-quality-gates.sh",
    "test:quality:gates:blocking": "COVERAGE_GATE_MODE=blocking bash scripts/testing/run-quality-gates.sh",
    "dev:web": "yarn workspace @ax-studio/web-app dev",
    "dev:electron": "node scripts/dev-electron.mjs",
    "build:electron": "yarn build:web && yarn workspace @ax-studio/electron build",
    "smoke:electron": "yarn workspace @ax-studio/electron smoke",
    "smoke:embed": "yarn workspace @ax-studio/electron-example-host smoke",
    "dist:electron": "node scripts/dist-electron.mjs",
    "dist:electron:mac": "node scripts/dist-electron.mjs --mac",
    "dist:electron:win": "node scripts/dist-electron.mjs --win",
    "build:core": "cd core && yarn build && yarn pack",
    "build:web": "yarn workspace @ax-studio/web-app build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "3.2.6",
    "husky": "^9.1.5",
    "jsdom": "^29.1.1",
    "lint-staged": "^15.4.3",
    "rimraf": "^6.0.1",
    "tar": "^7.5.22",
    "unzipper": "^0.12.3",
    "vitest": "^3.2.6"
  },
  "version": "2.2.2",
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "resolutions": {
    "yallist": "4.0.0",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2",
    "brace-expansion@npm:^2.0.1": "2.0.3",
    "@aws-sdk/client-bedrock-runtime@npm:3.609.0": "3.1079.0",
    "@eslint/plugin-kit@npm:^0.2.8": "0.3.4",
    "@smithy/config-resolver@npm:^3.0.4": "4.4.6",
    "@smithy/config-resolver@npm:^3.0.13": "4.4.6",
    "@smithy/config-resolver@npm:^4.2.1": "4.4.6",
    "bn.js@npm:^5.2.1": "5.2.3",
    "esbuild@npm:^0.27.0": "0.28.1",
    "fast-xml-parser@npm:5.2.5": "5.10.1",
    "form-data@npm:4.0.0": "4.0.6",
    "form-data@npm:^4.0.4": "4.0.6",
    "glob@npm:^10.2.2": "13.0.6",
    "glob@npm:^11.0.0": "13.0.6",
    "minimatch@npm:^10.0.3": "10.2.3",
    "minimatch@npm:^9.0.4": "9.0.7",
    "picomatch@npm:^4.0.2": "4.0.4",
    "picomatch@npm:^4.0.3": "4.0.4",
    "qs@npm:6.11.2": "6.15.2",
    "qs@npm:^6.12.3": "6.15.2",
    "tar@npm:^7.4.3": "7.5.19",
    "test-exclude@npm:^7.0.1": "8.0.0",
    "uuid@npm:^9.0.1": "11.1.1",
    "vite@npm:^5.0.0 || ^6.0.0 || ^7.0.0-0": "7.3.5",
    "ws@npm:^8.18.0": "8.21.0"
  },
  "packageManager": "yarn@4.5.3",
  "lint-staged": {
    "core/**/*.{ts,tsx}": [
      "yarn workspace @ax-studio/core lint --fix"
    ],
    "web-app/**/*.{ts,tsx,js,jsx}": [
      "yarn workspace @ax-studio/web-app lint --fix"
    ]
  }
}
